#include <SPI.h>
#include <SD.h>

// Pins
#define TRIG_PIN D1
#define ECHO_PIN D2
#define SD_CS D8

// Detection range (cm)
#define MIN_DISTANCE 20
#define MAX_DISTANCE 350

// Leave delay (ms)
#define LEAVE_DELAY 3000

File myFile;
int carCount = 0;

void setup() {
  Serial.begin(115200);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);

  Serial.println("Starting...");

  // Ensure SD initializes
  while (!SD.begin(SD_CS)) {
    Serial.println("SD failed, retrying...");
    delay(1000);
  }

  Serial.println("SD OK");

  myFile = SD.open("log.csv", FILE_WRITE);
  if (myFile) {
    myFile.println("Car#,Start_s,End_s,Duration_s");
    myFile.close();
  }
}

void loop() {
  static bool carPresent = false;
  static unsigned long startMillis = 0;
  static unsigned long lastSeenMillis = 0;

  long duration;
  float distance;

  // Trigger ultrasonic
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  duration = pulseIn(ECHO_PIN, HIGH, 30000);

  if (duration == 0) {
    distance = -1;
  } else {
    distance = duration * 0.034 / 2;
  }

  unsigned long nowMillis = millis();

  // === DETECT CAR ===
  if (distance > MIN_DISTANCE && distance < MAX_DISTANCE) {
    lastSeenMillis = nowMillis;

    if (!carPresent) {
      carPresent = true;
      startMillis = nowMillis;
      carCount++;

      Serial.print("Car ");
      Serial.print(carCount);
      Serial.println(" detected");
    }
  }

  // === CAR LEFT ===
  if (carPresent && (nowMillis - lastSeenMillis > LEAVE_DELAY)) {

    unsigned long endMillis = nowMillis;

    // ✅ Correct duration calc (in ms first)
    long durationMs = (endMillis - startMillis) - LEAVE_DELAY;
    if (durationMs < 0) durationMs = 0;

    float durationSec = durationMs / 1000.0;

    // Convert start/end to seconds
    unsigned long startSec = startMillis / 1000;
    unsigned long endSec = endMillis / 1000;

    myFile = SD.open("log.csv", FILE_WRITE);
    if (myFile) {
      myFile.print(carCount);
      myFile.print(",");
      myFile.print(startSec);
      myFile.print(",");
      myFile.print(endSec);
      myFile.print(",");
      myFile.println(durationSec);
      myFile.close();
    }

    Serial.print("Car ");
    Serial.print(carCount);
    Serial.print(" duration: ");
    Serial.print(durationSec);
    Serial.println(" sec");

    carPresent = false;
  }

  delay(200);
}
